<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's frame: a scrolling list, with a control strip down the right edge.

  The strip is a sibling of the list rather than part of each row, so it reads
  as one continuous edge at any size and stays reachable when the list is
  scrolled or empty. It carries two targets: resync at the top, in roughly one
  cell, and add filling the rest, so the control you reach for most often is
  the larger one and the one you rarely want cannot be hit by accident.

  The two overlap on purpose. The list runs under the left quarter of the
  strip, so a task's text can use that space instead of stopping short of it,
  and the strip is the later child, so it is drawn on top and takes every tap
  in the shared band: a tap there adds or syncs, never edits. The strip has no
  background of its own, which is what lets the text show through.

  No left padding on the frame: each row supplies its own left spacing, so the
  tap target for completing a task can start at the widget's very edge.

  Every element here has to be one RemoteViews can inflate. That list is short
  and does not include a plain View, so even the hairline divider is a
  FrameLayout with a background. Using a View there fails at inflation time
  and the launcher reports only "Couldn't add widget".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingEnd="4dp">

    <!-- Ends a quarter of the way across the 30dp strip, which overlaps it from above. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="22.5dp">

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="10dp"
            android:textSize="13sp"
            android:textColor="@color/widget_text_secondary"
            android:text="@string/widget_empty" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical">

        <!-- Resync: about one cell tall, so it stays a deliberate tap. -->
        <FrameLayout
            android:id="@+id/widget_sync"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/widget_row_ripple"
            android:contentDescription="@string/widget_sync_description">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_sync"
                android:contentDescription="@string/widget_sync_description" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="15dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/widget_divider" />

        <!-- Add: everything below, so the common action is the big target. -->
        <FrameLayout
            android:id="@+id/widget_add"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_row_ripple"
            android:contentDescription="@string/widget_add_description">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_add"
                android:contentDescription="@string/widget_add_description" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
