<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget colours, light.

  A deliberate copy of the tokens in packages/ui/src/tokens.css rather than a
  reference to them: a RemoteViews tree is inflated by the launcher's process
  and cannot read anything from the webview. These are the light theme's accent,
  text and secondary-text values, with the surface carrying the same alpha the
  desktop widget uses (0.82, or D1 in hex).

  The dot and the two controls are the accent at reduced opacity. Everything
  here is on screen all day; at full strength the accent is the first thing the
  eye lands on, which is wrong for a panel meant to sit quietly on a wallpaper.
-->
<resources>
    <color name="widget_surface">#D1FFFFFF</color>
    <color name="widget_text">#FF1B1B20</color>
    <color name="widget_text_secondary">#FF63636E</color>
    <color name="widget_text_done">#8C63636E</color>
    <color name="widget_accent">#FF5B5BD6</color>
    <color name="widget_dot">#B85B5BD6</color>
    <color name="widget_dot_done">#5963636E</color>
    <color name="widget_control">#8C5B5BD6</color>
    <color name="widget_divider">#1A000000</color>
    <color name="widget_ripple">#33000000</color>
</resources>
