<?xml version="1.0" encoding="utf-8"?>
<!--
  One task row.

  Two independent tap targets: the dot completes, the body opens the editor. In
  a collection widget each child can carry its own fill-in intent, which is what
  makes that possible without a separate button per row.

  The dot's target is far wider than the dot itself: this is the control most
  likely to be tapped without looking.

  Row geometry matches the web surfaces, which put 13.5px type in a 28px row:
  here 14sp type in a 32dp row, so the space between one line and the next is
  the same fraction of the text on the home screen as it is in the app. The
  text's vertical padding is what a wrapped row gets; a single line is centred
  by the row's minHeight.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_row_ripple"
    android:minHeight="32dp">

    <FrameLayout
        android:id="@+id/item_toggle"
        android:layout_width="38dp"
        android:layout_height="match_parent"
        android:minHeight="32dp">

        <ImageView
            android:id="@+id/item_dot"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_dot" />
    </FrameLayout>

    <TextView
        android:id="@+id/item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingEnd="8dp"
        android:textSize="14sp"
        android:textColor="@color/widget_text"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
