<?xml version="1.0" encoding="utf-8"?>
<!--
  One task row.

  Two independent tap targets: the dot completes, the body opens the editor. In
  a collection widget each child can carry its own fill-in intent, which is what
  makes that possible without a separate button per row.

  Horizontal geometry, from the widget's left edge: about 10.7dp of space (half
  the 21.3dp the row had originally), the dot (about 3.7dp across), 4.3dp, then
  the text with no padding of its own. The dot's tap target is everything left
  of the text, so it starts at the very edge of the widget; the root frame has
  no left padding for that reason.

  The dot drawable keeps its old artwork, drawn at half size: a 10dp image
  whose circle spans 7.6 to 16.4 of a 24-unit viewport, so the circle starts
  3.17dp in, and a 7.5dp margin brings its left edge to 10.67dp.

  Vertically the row matches the web surfaces, which put 13.5px type in a 28px
  row: here 14sp type in a 32dp row. The text's vertical padding is what a
  wrapped row gets; a single line is centred by the row's minHeight.
-->
<!--
  The outer frame carries Customize's task margins as padding, so the space
  around a row sits outside its tap highlight, as a margin does in the app.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_row_ripple"
    android:minHeight="32dp">

    <FrameLayout
        android:id="@+id/item_toggle"
        android:layout_width="18.6dp"
        android:layout_height="match_parent"
        android:minHeight="32dp">

        <ImageView
            android:id="@+id/item_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="7.5dp"
            android:src="@drawable/ic_widget_dot" />
    </FrameLayout>

    <TextView
        android:id="@+id/item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="14sp"
        android:textColor="@color/widget_text"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
</FrameLayout>
