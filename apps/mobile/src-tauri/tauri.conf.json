{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recall",
  "version": "0.1.0",
  "identifier": "com.swapnil.recall",
  "build": {
    "beforeDevCommand": "pnpm --filter @recall/mobile dev:vite",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "pnpm --filter @recall/mobile build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Recall",
        "url": "index.html"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["recall"],
          "host": "auth-callback"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "copyright": "Recall",
    "category": "Productivity",
    "shortDescription": "Synchronized external memory",
    "longDescription": "One task list, always on your home screen and synchronized with your desktop, browser and the web.",
    "android": {
      "minSdkVersion": 26
    }
  }
}
