        "--filter",
        "@recall/web",
        "dev:demo",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@recall/web",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "desktop-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@recall/desktop",
        "dev:vite:demo"
      ],
      "port": 5174
